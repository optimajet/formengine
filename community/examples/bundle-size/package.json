{
  "name": "@react-form-builder/bundle-size",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bundle size comparison",
  "workspaces": [
    "formengine",
    "rjsf",
    "survey",
    "vueform",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "report": "node scripts/analyze-bundle-sizes.ts",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "npx @biomejs/biome format --write .",
    "check:tsc": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@rspack/cli": "^2.0.0",
    "ajv": "8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup-plugin-bundle-stats": "^4.21.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@eslint/js": "^9.39.4",
    "@react-form-builder/cli-lib": "file:../../scripts/cli-lib",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.2",
    "vite-bundle-analyzer": "^1.3.6",
    "vite-plugin-bundlesize": "^0.3.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "ajv": "6.12.6"
    }
  }
}
